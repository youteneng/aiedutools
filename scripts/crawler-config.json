{
  "interval": "daily",
  "keywordFallback": {
    "enabled": true,
    "triggerMinTools": 25,
    "queries": [
      "AI education tools",
      "AI tutor tools",
      "AI learning tools",
      "AI lesson planning",
      "AI quiz generator",
      "AI grading tools",
      "AI classroom management",
      "AI edtech tools",
      "AI language learning tools",
      "AI writing assistant for teachers",
      "AI reading comprehension tools",
      "AI Chinese language teaching tools",
      "AI math teaching tools",
      "AI math problem generator for class",
      "AI English teaching tools",
      "AI speaking practice for students",
      "AI science teaching tools",
      "AI STEM classroom tools",
      "AI history teaching tools",
      "AI geography teaching tools",
      "AI homework assistant for school",
      "AI worksheet generator for teachers",
      "AI exam prep tools for students"
    ],
    "maxPerQuery": 16
  },
  "detailEnrichment": {
    "enabled": true,
    "maxTools": 24,
    "timeoutMs": 9000,
    "concurrency": 3,
    "modules": {
      "overview": true,
      "features": true,
      "useCases": true,
      "pricingPlans": true,
      "maxFeatures": 4,
      "maxUseCases": 3,
      "maxPricingPlans": 4
    }
  },
  "priorityStrategy": {
    "enabled": true,
    "tiersOrder": ["high", "medium", "low"],
    "defaultTier": "medium",
    "stopWhenToolsAtLeast": 120
  },
