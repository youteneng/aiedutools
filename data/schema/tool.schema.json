{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ShihangAI Tool Schema",
  "description": "师航AI 工具标准结构（最小可行版）",
  "type": "object",
  "required": [
    "id",
    "slug",
    "name",
    "short_description",
    "official_url",
    "review_status",
    "source_type",
    "last_updated",
    "is_active",
    "featured"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "slug": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "short_description": { "type": "string" },
    "full_description": { "type": "string" },
    "category": { "type": "string" },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": { "type": "string" },
          "context": { "type": "string" },
          "value": { "type": "string" }
        }
      }
    },
    "target_users": { "type": "array", "items": { "type": "string" } },
    "usage_scenarios": { "type": "array", "items": { "type": "string" } },
    "education_stages": { "type": "array", "items": { "type": "string" } },
    "subjects": { "type": "array", "items": { "type": "string" } },
    "chinese_support": { "type": "string", "enum": ["强", "中", "弱"] },
    "access_type": { "type": "string", "enum": ["国内可直连", "需注册", "需特殊网络"] },
    "pricing_type": { "type": "string", "enum": ["免费", "免费增值", "付费"] },
    "rating": { "type": "number", "minimum": 0, "maximum": 5 },
    "editor_note": { "type": "string" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "official_url": { "type": "string", "minLength": 1 },
    "cover_image": { "type": "string" },
    "review_status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
    "source_type": { "type": "string", "enum": ["官方信息", "编辑整理", "社区实测"] },
    "last_updated": { "type": "string" },
    "updated_at": { "type": "string" },
    "is_active": { "type": "boolean" },
    "featured": { "type": "boolean" },
    "is_member_only": { "type": "boolean" }
  }
}
